# Configuration RAG notes de cours Obsidian

# Clé API Google Gemini (obligatoire pour la génération d'embeddings et requêtes RAG)
GEMINI_API_KEY=votre_cle_api_gemini_ici

# Chemin vers le vault Obsidian (lecture seule)
OBSIDIAN_VAULT_PATH=/run/media/selasmsi/Windows/Programming_travel/

# --- Génération des réponses -------------------------------------------------
# Backend de génération : gemini (défaut) | anthropic | local
# Le retrieval utilise toujours les embeddings Gemini : GEMINI_API_KEY reste requise.
GENERATOR_BACKEND=gemini

# Gemini
# GEMINI_GENERATION_MODEL=gemini-3.8-flash

# Anthropic (Claude)
# ANTHROPIC_API_KEY=votre_cle_api_anthropic_ici
# ANTHROPIC_MODEL=claude-opus-5-5

# Local (Ollama)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT=600
